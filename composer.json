{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "intervention/image": "^3.11",
        "laravel-notification-channels/twilio": "^4.1",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "maatwebsite/excel": "^1.1",
        "nwidart/laravel-modules": "^12.0",
        "predis/predis": "^3.6",
        "spatie/laravel-activitylog": "^4.12",
        "spatie/laravel-backup": "^9.3",
        "spatie/laravel-permission": "^6.25",
        "spatie/laravel-translatable": "^6.11",
        "yajra/laravel-datatables-oracle": "^12.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/breeze": "*",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
       "psr-4": {
        "App\\": "app/",
        "Database\\Factories\\": "database/factories/",
        "Database\\Seeders\\": "database/seeders/",

        "Modules\\Core\\": "Modules/Core/app/",
        "Modules\\Core\\Database\\Factories\\": "Modules/Core/database/factories/",
        "Modules\\Core\\Database\\Seeders\\": "Modules/Core/database/seeders/",

        "Modules\\Certificate\\": "Modules/Certificate/app/",
        "Modules\\Certificate\\Database\\Factories\\": "Modules/Certificate/database/factories/",
        "Modules\\Certificate\\Database\\Seeders\\": "Modules/Certificate/database/seeders/",

        "Modules\\Citizen\\": "Modules/Citizen/app/",
        "Modules\\Citizen\\Database\\Factories\\": "Modules/Citizen/database/factories/",
        "Modules\\Citizen\\Database\\Seeders\\": "Modules/Citizen/database/seeders/",

        "Modules\\Accounts\\": "Modules/Accounts/app/",
        "Modules\\Accounts\\Database\\Factories\\": "Modules/Accounts/database/factories/",
        "Modules\\Accounts\\Database\\Seeders\\": "Modules/Accounts/database/seeders/",

        "Modules\\Report\\": "Modules/Report/app/",
        "Modules\\Report\\Database\\Factories\\": "Modules/Report/database/factories/",
        "Modules\\Report\\Database\\Seeders\\": "Modules/Report/database/seeders/",

        "Modules\\Setting\\": "Modules/Setting/app/",
        "Modules\\Setting\\Database\\Factories\\": "Modules/Setting/database/factories/",
        "Modules\\Setting\\Database\\Seeders\\": "Modules/Setting/database/seeders/",

        "Modules\\Applicant\\": "Modules/Applicant/app/",
        "Modules\\Applicant\\Database\\Factories\\": "Modules/Applicant/database/factories/",
        "Modules\\Applicant\\Database\\Seeders\\": "Modules/Applicant/database/seeders/",

        "Modules\\Payment\\": "Modules/Payment/app/",
        "Modules\\Payment\\Database\\Factories\\": "Modules/Payment/database/factories/",
        "Modules\\Payment\\Database\\Seeders\\": "Modules/Payment/database/seeders/"
    },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}